routine _start {
    // Slice 11: Minimal Bootstrapping Runtime
    // CPU stack pointer initialization
    unsafe {
        reg rsp = 0x7FFFFFFF
        reg rbp = 0x7FFFFFFF
    }
    
    // BSS clearing
    cap bss = 0x200000..0x210000
    routine clear_bss(bss)
    
    // Global Descriptor Table (GDT) load
    cap gdt = 0x10000..0x10100
    unsafe {
        load_gdt(gdt)
    }
    
    // Jump to kernel main
    routine kernel_main()
}
