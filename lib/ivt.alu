// Slice 13: Interrupt Vector Table (IVT)
routine init_ivt {
    cap ivt_base = 0x0..0x400
    
    // Bare-metal mapping of CPU exception handling
    unsafe {
        // Divide by zero
        map_ivt(ivt_base, 0, handler_div0)
        // NMI
        map_ivt(ivt_base, 2, handler_nmi)
        // General Protection Fault
        map_ivt(ivt_base, 13, handler_gpf)
        // Page Fault
        map_ivt(ivt_base, 14, handler_pf)
    }
}
