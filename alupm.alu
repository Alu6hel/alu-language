import std::fs
import std::crypto::sha256
import kybalion::p2p_dht // Connect to the Decentralized Swarm

// Serializes and uploads a local ALU package to the Kybalion DHT
routine publish_package(package_path: ptr<u8>) {
    print("[ALUPM] Serializing package at path: ", package_path);
    let pkg_data = fs::read_all_bytes(package_path);
    
    // Hash the package to generate its global ID
    let pkg_hash = sha256::hash(pkg_data);
    print("[ALUPM] Package SHA-256 Hash: ", pkg_hash);
    
    // Broadcast to the decentralized swarm
    print("[ALUPM] Broadcasting to Kybalion P2P DHT...");
    let swarm_status = p2p_dht::distribute(pkg_hash, pkg_data);
    
    if (swarm_status == OK) {
        print("[SUCCESS] Package successfully seeded to the global swarm.");
        print("          It is now censorship-resistant and permanently hosted.");
    } else {
        print("[ERROR] Failed to connect to swarm peers.");
    }
}

// Queries the DHT and reconstructs the package locally
routine install_package(package_hash: ptr<u8>) {
    print("[ALUPM] Searching Kybalion DHT for package: ", package_hash);
    
    // Connect to peers to download chunks
    let pkg_data = p2p_dht::retrieve(package_hash);
    
    if (pkg_data != null) {
        print("[ALUPM] Package chunks successfully retrieved from peers.");
        print("[ALUPM] Verifying SHA-256 integrity...");
        
        let verify_hash = sha256::hash(pkg_data);
        if (verify_hash == package_hash) {
            print("[SUCCESS] Integrity confirmed. Installing to std/lib...");
            fs::write_bytes("std/lib/" + package_hash, pkg_data);
            print("[SUCCESS] Installation complete.");
        } else {
            print("[ERROR] Package corrupted during P2P transit.");
        }
    } else {
        print("[ERROR] Package not found in the global swarm.");
    }
}
