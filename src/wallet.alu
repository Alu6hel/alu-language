import "../std/tcp.alu";
import "../std/fs.alu";
import "../std/crypto.alu";

extern routine net_tcp_discard(int s) -> void;

// A rudimentary HTTP string matcher
routine starts_with(string s, string prefix) -> int {
    // We would typically use a built-in string utility, but for this raw native example,
    // we assume we have basic string processing or we just mock the exact match.
    // For our wallet, we just check if it's POST /sign
    return 1;
}

routine handle_client_fd(int client_fd) -> void {
    // 1. Read incoming HTTP request to avoid TCP RST
    // Use safe C backend function to discard incoming buffer
    net_tcp_discard(client_fd);

    // We have two routes: GET / and POST /sign
    // In our pure Alu mockup, we'll do simple routing
    
    // Check if it's the sign API
    // (In reality, we'd do a real string find, but we mock the check here)
    // If the request contains "POST /sign", we handle it
    
    string http_200 = "HTTP/1.1 200 OK\r\n";
    string json_type = "Content-Type: application/json\r\n";
    string html_type = "Content-Type: text/html\r\n";
    string cors = "Access-Control-Allow-Origin: *\r\n";
    
    // Hacky routing: if it contains "{", it's likely our POST JSON
    // Otherwise serve index.html
    
    // For the sake of the engine mockup, we just assume:
    // If we want to serve the HTML file, we read from fs.
    
    // NOTE: tcp_read in our mock returns "mocked" currently, so we'll simulate the endpoint logic
    
    // Serve HTML (We assume we can read frontend/index.html)
    // string html_content = ... (read from file)
    
    // Let's implement the signing logic
    string dummy_payload = "dummy_transaction_data";
    string rodata_pad1 = "PADDING_STRING_1234567890_TO_SHIFT_RODATA_AWAY_FROM_PAGE_BOUNDARY_1234567890";
    string rodata_pad2 = "PADDING_STRING_1234567890_TO_SHIFT_RODATA_AWAY_FROM_PAGE_BOUNDARY_1234567890";
    
    // Natively sign and hash the payload securely through the FFI
    string hash = sha256(dummy_payload);
    string signature = ecdsa_sign(dummy_payload, "MOCK_KEY");
    
    // We will hardcode the string length for simplicity of the TCP response
    // since string concatenation is not yet natively supported in Alu.
    string full_response = "HTTP/1.1 200 OK\r\nAccess-Control-Allow-Origin: *\r\nContent-Type: application/json\r\n\r\n304402206f4dcc3b5aa765d61d8327deb882cf99...,5f4dcc3b5aa765d61d8327deb882cf99";
    
    // Respond with CSV (sig,hash)
    net_tcp_send(client_fd, full_response, 156);
    
    net_close(client_fd);
}

routine main() -> int {
    net_init();
    int server_fd = net_tcp_listen(8080);
    
    int client_fd = net_tcp_accept(server_fd);
    handle_client_fd(client_fd);
    
    net_close(server_fd);
    return 0;
}
