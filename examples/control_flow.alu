routine calculate_secret(int start, int limit) -> int {
    int counter = start;
    int accumulator = 0;
    
    for (; counter < limit; counter = counter + 1) { accumulator = accumulator + 5;
         }
    
    return accumulator;
}

routine main() {
    int x = 10;
    
    if (x == 10) {
        unsafe {
            asm("Condition met! Entering True Block...");
        }
    } else {
        unsafe {
            asm("Condition failed! This is the False block.");
        }
    }
    
    int result = calculate_secret(0, 3);
    
    if (result > 10) {
        unsafe {
            asm("Function returned successfully! Loops and Branching work.");
        }
    }
}
