; ModuleID = 'alu_module'
source_filename = "alu_source.alu"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc"

declare i32 @puts(i8*)

@__alu_exception_msg = global i8* null, align 8

@__alu_parent_fiber = global i8* null, align 8
@__alu_child_fiber = global i8* null, align 8

declare i8* @malloc(i64)
declare void @free(i8*)

define i8* @alu_alloc(i64 %size) {
entry:
  %total_size = add i64 %size, 8
  %raw_ptr = call i8* @malloc(i64 %total_size)
  %header_ptr = bitcast i8* %raw_ptr to i64*
  store i64 1, i64* %header_ptr, align 8
  %data_ptr = getelementptr inbounds i8, i8* %raw_ptr, i64 8
  ret i8* %data_ptr
}

define void @alu_retain(i8* %ptr) {
entry:
  %is_null = icmp eq i8* %ptr, null
  br i1 %is_null, label %end, label %retain
retain:
  %header_ptr_i8 = getelementptr inbounds i8, i8* %ptr, i64 -8
  %header_ptr = bitcast i8* %header_ptr_i8 to i64*
  %refcount = load i64, i64* %header_ptr, align 8
  %new_refcount = add i64 %refcount, 1
  store i64 %new_refcount, i64* %header_ptr, align 8
  br label %end
end:
  ret void
}

define void @alu_release(i8* %ptr) {
entry:
  %is_null = icmp eq i8* %ptr, null
  br i1 %is_null, label %end, label %release
release:
  %header_ptr_i8 = getelementptr inbounds i8, i8* %ptr, i64 -8
  %header_ptr = bitcast i8* %header_ptr_i8 to i64*
  %refcount = load i64, i64* %header_ptr, align 8
  %new_refcount = sub i64 %refcount, 1
  store i64 %new_refcount, i64* %header_ptr, align 8
  %is_zero = icmp eq i64 %new_refcount, 0
  br i1 %is_zero, label %free_block, label %end
free_block:
  call void @free(i8* %header_ptr_i8)
  br label %end
end:
  ret void
}

declare i8* @ConvertThreadToFiber(i8*)
declare i8* @CreateFiber(i64, i8*, i8*)
declare void @SwitchToFiber(i8*)

%JNIEnv = type { i32 }

%jobject = type { i32 }

%jstring = type { i32 }

%jclass = type { i32 }

declare i8* @GetStringUTFChars(%JNIEnv**, %jstring**, i32*)

declare void @ReleaseStringUTFChars(%JNIEnv**, %jstring**, i8*)

declare %jclass** @FindClass(%JNIEnv**, i8*)

declare i32 @GetMethodID(%JNIEnv**, %jclass**, i8*, i8*)

declare void @CallVoidMethod(%JNIEnv**, %jobject**, i32)

define i32 @Java_com_aegis_ShieldService_scanFile(%JNIEnv** %in_env, %jobject** %in_thiz, %jstring** %in_filePath) {
entry:
  %env = alloca %JNIEnv**, align 4
  store %JNIEnv** %in_env, %JNIEnv*** %env, align 4
  %thiz = alloca %jobject**, align 4
  store %jobject** %in_thiz, %jobject*** %thiz, align 4
  %filePath = alloca %jstring**, align 4
  store %jstring** %in_filePath, %jstring*** %filePath, align 4
  %isCopy = alloca i32, align 4
  store i32 0, i32* %isCopy, align 4
  %path = alloca i8*, align 4
  %t1 = load %JNIEnv**, %JNIEnv*** %env, align 4
  %t2 = bitcast %JNIEnv** %t1 to i8*
  call void @alu_retain(i8* %t2)
  %t3 = load %jstring**, %jstring*** %filePath, align 4
  %t4 = bitcast %jstring** %t3 to i8*
  call void @alu_retain(i8* %t4)
  %t5 = call i8* @GetStringUTFChars(%JNIEnv** %t1, %jstring** %t3, i32* %isCopy)
  %t6 = bitcast %JNIEnv** %t1 to i8*
  call void @alu_release(i8* %t6)
  %t7 = bitcast %jstring** %t3 to i8*
  call void @alu_release(i8* %t7)
  %t8 = bitcast i32* %isCopy to i8*
  call void @alu_release(i8* %t8)
  %t9 = load i8*, i8** @__alu_exception_msg, align 8
  %t10 = icmp ne i8* %t9, null
  br i1 %t10, label %ex_handle1, label %cont0
ex_handle1:
  %t11 = load i8*, i8** %path, align 4
  %t12 = bitcast i8* %t11 to i8*
  call void @alu_release(i8* %t12)
  ret i32 0
cont0:
  store i8* %t5, i8** %path, align 4
  %threatLevel = alloca i32, align 4
  store i32 0, i32* %threatLevel, align 4
  %t13 = load %JNIEnv**, %JNIEnv*** %env, align 4
  %t14 = bitcast %JNIEnv** %t13 to i8*
  call void @alu_retain(i8* %t14)
  %t15 = load %jstring**, %jstring*** %filePath, align 4
  %t16 = bitcast %jstring** %t15 to i8*
  call void @alu_retain(i8* %t16)
  %t17 = load i8*, i8** %path, align 4
  %t18 = bitcast i8* %t17 to i8*
  call void @alu_retain(i8* %t18)
  call void @ReleaseStringUTFChars(%JNIEnv** %t13, %jstring** %t15, i8* %t17)
  %t19 = bitcast %JNIEnv** %t13 to i8*
  call void @alu_release(i8* %t19)
  %t20 = bitcast %jstring** %t15 to i8*
  call void @alu_release(i8* %t20)
  %t21 = bitcast i8* %t17 to i8*
  call void @alu_release(i8* %t21)
  %t22 = load i8*, i8** @__alu_exception_msg, align 8
  %t23 = icmp ne i8* %t22, null
  br i1 %t23, label %ex_handle3, label %cont2
ex_handle3:
  %t24 = load i8*, i8** %path, align 4
  %t25 = bitcast i8* %t24 to i8*
  call void @alu_release(i8* %t25)
  ret i32 0
cont2:
  %t26 = load i8*, i8** %path, align 4
  %t27 = bitcast i8* %t26 to i8*
  call void @alu_release(i8* %t27)
  %t28 = load i32, i32* %threatLevel, align 4
  ret i32 %t28
  %t29 = load i8*, i8** %path, align 4
  %t30 = bitcast i8* %t29 to i8*
  call void @alu_release(i8* %t30)
  ret i32 0
}


