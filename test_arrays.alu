import "std.alu";

routine main() -> int {
    int numbers[5];
    numbers[0] = 10;
    numbers[1] = 20;
    numbers[2] = 30;
    numbers[3] = 40;
    numbers[4] = 50;

    int sum = 0;
    for (int i = 0; i < 5; i = i + 1) {
        sum = sum + numbers[i];
    }
    
    print("Array sum:");
    print_int(sum);
    return 0;
}
