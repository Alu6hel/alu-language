import compiler::ast;

extern routine get_null_ast() -> ptr<ASTNode>;
extern routine get_null_scope() -> ptr<Scope>;
extern routine get_null_symbol() -> ptr<Symbol>;
extern routine get_null_type() -> ptr<Type>;

routine is_null_ast(ptr<ASTNode> p) -> int {
    if (p == get_null_ast()) { return 1; }
    return 0;
}

routine is_null_scope(ptr<Scope> p) -> int {
    if (p == get_null_scope()) { return 1; }
    return 0;
}

routine is_null_symbol(ptr<Symbol> p) -> int {
    if (p == get_null_symbol()) { return 1; }
    return 0;
}

routine is_null_type(ptr<Type> p) -> int {
    if (p == get_null_type()) { return 1; }
    return 0;
}
