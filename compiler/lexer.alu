// ALU Self-Hosted Lexer



extern routine read_char_c(string s, int idx) -> int;
extern routine alu_string_substr(string s, int start, int len) -> string;


struct Token {
    int token_type;
    string value;
    ptr<Token> next;
}

routine get_null_token() -> ptr<Token> {
    ptr<Token> p = alloc(0);
    return p;
}

routine create_token(int type, string val) -> ptr<Token> {
    ptr<Token> tok = alloc(32);
    tok.token_type = type;
    tok.value = val;
    tok.next = get_null_token();
    return tok;
}

routine is_alpha(int c) -> int {
    if (c >= 65) { if (c <= 90) { return 1; } } // A-Z
    if (c >= 97) { if (c <= 122) { return 1; } } // a-z
    if (c == 95) { return 1; } // _
    return 0;
}

routine is_digit(int c) -> int {
    if (c >= 48) { if (c <= 57) { return 1; } } // 0-9
    return 0;
}

routine is_alphanum(int c) -> int {
    if (is_alpha(c) == 1) { return 1; }
    if (is_digit(c) == 1) { return 1; }
    return 0;
}

routine tokenize_source(string input, int input_size) -> ptr<Token> {
    print("Entered tokenize_source");
    ptr<Token> head = get_null_token();
    print("Got head");
    ptr<Token> tail = get_null_token();
    print("Got tail");
    int pos = 0;

    while (pos < input_size) {
        int c = read_char_c(input, pos);
        int m = 0;
        
        if (m == 0) { if (c == 32) { pos = pos + 1; m = 1; } }
        if (m == 0) { if (c == 10) { pos = pos + 1; m = 1; } }
        if (m == 0) { if (c == 13) { pos = pos + 1; m = 1; } }
        if (m == 0) { if (c == 9)  { pos = pos + 1; m = 1; } }
        
        if (m == 0) { if (is_alpha(c) == 1) {
            int start = pos;
            int reading = 1;
            while (reading == 1) {
                if (pos < input_size) {
                    if (is_alphanum(read_char_c(input, pos)) == 1) {
                        pos = pos + 1;
                    } else {
                        reading = 0;
                    }
                } else {
                    reading = 0;
                }
            }
            string val = alu_string_substr(input, start, pos - start);
            int t = 1; // TOK_IDENTIFIER
            if (str_eq(val, "routine") == 1) { t = 5; } // TOK_ROUTINE
            if (str_eq(val, "extern") == 1) { t = 6; } // TOK_EXTERN
            if (str_eq(val, "struct") == 1) { t = 8; } // TOK_STRUCT
            if (str_eq(val, "return") == 1) { t = 10; } // TOK_RETURN
            if (str_eq(val, "if") == 1) { t = 13; } // TOK_IF
            if (str_eq(val, "else") == 1) { t = 14; } // TOK_ELSE
            if (str_eq(val, "while") == 1) { t = 15; } // TOK_WHILE
            if (str_eq(val, "int") == 1) { t = 26; } // TOK_INT_TYPE
            if (str_eq(val, "ptr") == 1) { t = 1; } // IDENTIFIER for ptr (mapped as identifier for now)
            if (str_eq(val, "new") == 1) { t = 1; } // mapped as identifier
            
            ptr<Token> tok = create_token(t, val);
            if (head == get_null_token()) {
                head = tok;
                tail = tok;
            } else {
                tail.next = tok;
                tail = tok;
            }
            m = 1;
        }}
        
        if (m == 0) { if (is_digit(c) == 1) {
            int start = pos;
            int reading = 1;
            while (reading == 1) {
                if (pos < input_size) {
                    if (is_digit(read_char_c(input, pos)) == 1) {
                        pos = pos + 1;
                    } else {
                        reading = 0;
                    }
                } else {
                    reading = 0;
                }
            }
            string val = alu_string_substr(input, start, pos - start);
            ptr<Token> tok = create_token(3, val); // TOK_INT_LITERAL
            if (head == get_null_token()) { head = tok; tail = tok; }
            else { tail.next = tok; tail = tok; }
            m = 1;
        }}
        
        if (m == 0) { if (c == 40) { // '('
            ptr<Token> tok = create_token(36, "("); // TOK_LPAREN
            if (head == get_null_token()) { head = tok; tail = tok; } else { tail.next = tok; tail = tok; }
            pos = pos + 1; m = 1;
        }}
        if (m == 0) { if (c == 41) { // ')'
            ptr<Token> tok = create_token(37, ")"); // TOK_RPAREN
            if (head == get_null_token()) { head = tok; tail = tok; } else { tail.next = tok; tail = tok; }
            pos = pos + 1; m = 1;
        }}
        if (m == 0) { if (c == 123) { // '{'
            ptr<Token> tok = create_token(38, "{"); // TOK_LBRACE
            if (head == get_null_token()) { head = tok; tail = tok; } else { tail.next = tok; tail = tok; }
            pos = pos + 1; m = 1;
        }}
        if (m == 0) { if (c == 125) { // '}'
            ptr<Token> tok = create_token(39, "}"); // TOK_RBRACE
            if (head == get_null_token()) { head = tok; tail = tok; } else { tail.next = tok; tail = tok; }
            pos = pos + 1; m = 1;
        }}
        if (m == 0) { if (c == 60) { // '<'
            ptr<Token> tok = create_token(43, "<"); // TOK_LESS_THAN
            if (head == get_null_token()) { head = tok; tail = tok; } else { tail.next = tok; tail = tok; }
            pos = pos + 1; m = 1;
        }}
        if (m == 0) { if (c == 62) { // '>'
            ptr<Token> tok = create_token(45, ">"); // TOK_GREATER_THAN
            if (head == get_null_token()) { head = tok; tail = tok; } else { tail.next = tok; tail = tok; }
            pos = pos + 1; m = 1;
        }}
        if (m == 0) { if (c == 45) { // '-'
            if ((pos + 1) < input_size) {
                if (read_char_c(input, pos + 1) == 62) { // '>'
                    ptr<Token> tok = create_token(47, "->"); // TOK_ARROW
                    if (head == get_null_token()) { head = tok; tail = tok; } else { tail.next = tok; tail = tok; }
                    pos = pos + 2;
                } else {
                    ptr<Token> tok = create_token(49, "-"); // TOK_MINUS
                    if (head == get_null_token()) { head = tok; tail = tok; } else { tail.next = tok; tail = tok; }
                    pos = pos + 1;
                }
            } else {
                ptr<Token> tok = create_token(49, "-"); // TOK_MINUS
                if (head == get_null_token()) { head = tok; tail = tok; } else { tail.next = tok; tail = tok; }
                pos = pos + 1;
            }
            m = 1;
        }}
        if (m == 0) { if (c == 61) { // '='
            ptr<Token> tok = create_token(40, "="); // TOK_EQUALS
            if (head == get_null_token()) { head = tok; tail = tok; } else { tail.next = tok; tail = tok; }
            pos = pos + 1; m = 1;
        }}
        if (m == 0) { if (c == 59) { // ';'
            ptr<Token> tok = create_token(53, ";"); // TOK_SEMICOLON
            if (head == get_null_token()) { head = tok; tail = tok; } else { tail.next = tok; tail = tok; }
            pos = pos + 1; m = 1;
        }}
        if (m == 0) { if (c == 46) { // '.'
            ptr<Token> tok = create_token(55, "."); // TOK_DOT
            if (head == get_null_token()) { head = tok; tail = tok; } else { tail.next = tok; tail = tok; }
            pos = pos + 1; m = 1;
        }}
        if (m == 0) { if (c == 44) { // ','
            ptr<Token> tok = create_token(54, ","); // TOK_COMMA
            if (head == get_null_token()) { head = tok; tail = tok; } else { tail.next = tok; tail = tok; }
            pos = pos + 1; m = 1;
        }}
        if (m == 0) {
            print_str_3("[ALU Lexer] Warning: Unknown character at ", "", "");
            pos = pos + 1;
        }
    }
    
    ptr<Token> eof = create_token(0, "EOF");
    if (head == get_null_token()) { head = eof; } else { tail.next = eof; }
    
    return head;
}
