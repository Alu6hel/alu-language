// ST-02: Cryptography (std::crypto)
// Advanced OpenSSL ECDSA Signatures

extern routine ecdsa_sign_c(string message, int msg_len, string priv_key_pem) -> string;
extern routine sha256_c(string message, int msg_len) -> string;
extern routine strlen(string s) -> int;
extern routine malloc_c(int size) -> string;

// High-level wrapper for ECDSA signing
routine ecdsa_sign(string message, string private_key_pem) -> string {
    int msg_len = strlen(message);
    return ecdsa_sign_c(message, msg_len, private_key_pem);
}

routine sha256(string message) -> string {
    int msg_len = strlen(message);
    return sha256_c(message, msg_len);
}

// Cryptography functions end here
