// ALU Standard Library: thread.alu
// Threading primitives for spawning and managing OS threads.

// Spawn a new thread that executes the given routine.
// Returns a thread handle (integer ID) used to join or detach the thread.
@requires fn_ptr != null
extern routine thread_spawn(ptr<routine> fn_ptr) -> int;

// Block the calling thread until the target thread has finished execution.
// After joining, the thread handle is invalidated.
@requires thread_id != 0
extern routine thread_join(int thread_id) -> void;

// Detach the thread so it runs independently. Its resources are released
// automatically when it finishes. After detaching, the handle is invalidated.
@requires thread_id != 0
extern routine thread_detach(int thread_id) -> void;

// Return a unique integer ID for the calling thread.
extern routine thread_current_id() -> int;

// Yield the calling thread's remaining time slice to the OS scheduler.
extern routine thread_yield() -> void;

// Return the number of concurrent hardware threads supported by the system
// (typically the number of CPU cores/hyperthreads). Returns 1 if unknown.
extern routine thread_hardware_concurrency() -> int;

// Suspend the calling thread for the specified number of milliseconds.
@requires ms >= 0
extern routine sleep_ms(int ms) -> void;
