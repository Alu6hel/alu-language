// ALU Native Standard Library: sys
// Bindings to libc <stdlib.h> system functions

extern routine exit(int status) -> void;
extern routine system(string command) -> int;
extern routine getenv(string name) -> string;

// Fallback trampoline (kept for compatibility)
routine call_host_api(string symbol, string ptr) -> int {
    unsafe {
        asm("call_trampoline symbol, ptr");
        return 0;
    }
}
