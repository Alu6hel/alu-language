// ALU Native Standard Library: io
// Bindings to libc <stdio.h> for console I/O

extern routine printf(string format, ...) -> int;
extern routine puts(string str) -> int;
extern routine scanf(string format, ...) -> int;
extern routine getchar() -> int;
extern routine putchar(int c) -> int;
extern routine perror(string s) -> void;
extern routine system(string command) -> int;
extern routine fflush(int stream) -> int;
extern routine sprintf(string str, string format, ...) -> int;

routine print(string s) -> void {
    puts(s);
}


// Legacy routines for compatibility


routine bind_socket_legacy(int port) -> int {
    unsafe {
        asm("call_trampoline POSIX_BIND, port");
    }
    return 0;
}
