// ALU Native Standard Library: mem
// Bindings to libc <stdlib.h> and <string.h> for memory

extern routine malloc(int size) -> string;
extern routine free(string ptr) -> void;
extern routine calloc(int num, int size) -> string;
extern routine realloc(string ptr, int size) -> string;
extern routine memcpy(string dest, string src, int n) -> string;
extern routine memset(string str, int c, int n) -> string;
extern routine memcmp(string str1, string str2, int n) -> int;
