// std/zlib_huff.alu - Dynamic Huffman Tree builder
import "std/mem.alu";
import "std/math.alu";

routine set_int(string arr, int index, int val) {
    int offset = (index * 4);
    arr[offset] = (val & 255);
    arr[(offset + 1)] = ((val >> 8) & 255);
    arr[(offset + 2)] = ((val >> 16) & 255);
    arr[(offset + 3)] = ((val >> 24) & 255);
}

routine get_int(string arr, int index) -> int {
    int offset = (index * 4);
    int b0 = (int(arr[offset]) & 255);
    int b1 = (int(arr[(offset + 1)]) & 255);
    int b2 = (int(arr[(offset + 2)]) & 255);
    int b3 = (int(arr[(offset + 3)]) & 255);
    return (((b0 | (b1 << 8)) | (b2 << 16)) | (b3 << 24));
}

routine build_huffman_tree(string freqs, int num_syms, string lengths) {
    string node_freq = malloc(((num_syms * 2) * 4));
    string node_left = malloc(((num_syms * 2) * 4));
    string node_right = malloc(((num_syms * 2) * 4));
    int i = 0;
    string node_valid = malloc(((num_syms * 2) * 4));
    
    int num_nodes = num_syms;
    for (i = 0; i < num_syms; i = (i + 1)) {
        int f = get_int(freqs, i);
        if (f > 0) {
            set_int(node_freq, i, f);
            set_int(node_valid, i, 1);
        } else {
            set_int(node_freq, i, 0);
            set_int(node_valid, i, 0);
        }
        set_int(node_left, i, (0 - 1));
        set_int(node_right, i, (0 - 1));
    }
    
    int valid_count = 0;
    for (i = 0; i < num_syms; i = (i + 1)) {
        if (get_int(node_valid, i) == 1) { valid_count = (valid_count + 1); }
    }
    
    if (valid_count == 0) {
        set_int(lengths, 0, 1);
        set_int(lengths, 1, 1);
        free(node_freq); free(node_left); free(node_right); free(node_valid);
        return;
    }
    if (valid_count == 1) {
        int sym = 0;
        for (i = 0; i < num_syms; i = (i + 1)) {
            if (get_int(node_valid, i) == 1) { sym = i; }
        }
        int other = 0; if (sym == 0) { other = 1; }
        set_int(lengths, sym, 1);
        set_int(lengths, other, 1);
        free(node_freq); free(node_left); free(node_right); free(node_valid);
        return;
    }
    
    while (valid_count > 1) {
        int min1 = (0 - 1); int min1_freq = 2147483647;
        int min2 = (0 - 1); int min2_freq = 2147483647;
        
        for (int j = 0; j < num_nodes; j = (j + 1)) {
            if (get_int(node_valid, j) == 1) {
                int f2 = get_int(node_freq, j);
                if (f2 < min1_freq) {
                    min2 = min1; min2_freq = min1_freq;
                    min1 = j; min1_freq = f2;
                } else {
                    if (f2 < min2_freq) {
                        min2 = j; min2_freq = f2;
                    }
                }
            }
        }
        
        int new_node = num_nodes;
        num_nodes = (num_nodes + 1);
        
        set_int(node_freq, new_node, (min1_freq + min2_freq));
        set_int(node_left, new_node, min1);
        set_int(node_right, new_node, min2);
        set_int(node_valid, new_node, 1);
        
        set_int(node_valid, min1, 0);
        set_int(node_valid, min2, 0);
        
        valid_count = (valid_count - 1);
    }
    
    string node_depth = malloc((num_nodes * 4));
    set_int(node_depth, (num_nodes - 1), 0);
    
    for (int k = (num_nodes - 2); k >= 0; k = (k - 1)) {
        int p = (k + 1);
        int found_p = 0;
        for (; p < num_nodes; p = (p + 1)) { if ((get_int(node_left, p) == k) | (get_int(node_right, p) == k)) {
                found_p = p;
                p = num_nodes; // break
            }
             }
        int d = get_int(node_depth, found_p);
        set_int(node_depth, k, (d + 1));
    }
    
    for (i = 0; i < num_syms; i = (i + 1)) {
        if (get_int(freqs, i) > 0) {
            int len = get_int(node_depth, i);
            if (len > 15) { len = 15; } // Clamp just in case
            set_int(lengths, i, len);
        } else {
            set_int(lengths, i, 0);
        }
    }
    
    free(node_depth);
    free(node_freq); free(node_left); free(node_right); free(node_valid);
}

// Generate canonical codes from lengths
routine generate_codes(string lengths, int num_syms, string codes) {
    string bl_count = malloc((16 * 4));
    string next_code = malloc((16 * 4));
    int i = 0;
    
    for (i = 0; i < 16; i = (i + 1)) { set_int(bl_count, i, 0);  }
    
    for (i = 0; i < num_syms; i = (i + 1)) {
        int len1 = get_int(lengths, i);
        if (len1 > 0) {
            int c = get_int(bl_count, len1);
            set_int(bl_count, len1, (c + 1));
        }
    }
    
    int code = 0;
    set_int(bl_count, 0, 0);
    for (int bits = 1; bits <= 15; bits = (bits + 1)) {
        code = ((code + get_int(bl_count, (bits - 1))) << 1);
        set_int(next_code, bits, code);
    }
    
    for (i = 0; i < num_syms; i = (i + 1)) {
        int len2 = get_int(lengths, i);
        if (len2 != 0) {
            int nc = get_int(next_code, len2);
            set_int(codes, i, nc);
            set_int(next_code, len2, (nc + 1));
        }
    }
    
    free(bl_count);
    free(next_code);
}
