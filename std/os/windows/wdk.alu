// ALU Standard Library: os/windows/wdk.alu
// Windows Driver Kit (WDK) Ring-0 Definitions

// Equivalent to PDRIVER_OBJECT
struct DriverObject {
    reg device_object: ptr<u8>
    reg driver_extension: ptr<u8>
    reg hardware_database: ptr<u8>
    reg fast_io_dispatch: ptr<u8>
}

// Equivalent to PIRP
struct Irp {
    reg type: u16
    reg size: u16
    reg mdl_address: ptr<u8>
    reg flags: u32
}

extern "C" IoCreateDevice(driver: ptr<DriverObject>, ext_size: u32, name: ptr<u8>, type: u32, chars: u32, excl: bool, device: ptr<ptr<u8>>) -> u32
extern "C" IoCompleteRequest(irp: ptr<Irp>, priority: u8)

routine secure_io_complete(irp: ptr<Irp>) {
    prove { irp != null }
    IoCompleteRequest(irp, 0)
}
