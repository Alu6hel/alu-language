
routine crc32(string data, int offset, int length) -> int {
    int i = 0;
    string crc_table = malloc(256 * 4);
    for (i = 0; i < 256; i = i + 1) {
        int c = i;
        for (int j = 0; j < 8; j = j + 1) {
            if ((c & 1) != 0) {
                c = (0 - 306674912) ^ lsr(c, 1);
            } else {
                c = lsr(c, 1);
            }
        }
        
        crc_table[(i * 4)] = c & 255;
        crc_table[(i * 4) + 1] = lsr(c, 8) & 255;
        crc_table[(i * 4) + 2] = lsr(c, 16) & 255;
        crc_table[(i * 4) + 3] = lsr(c, 24) & 255;
        
    }
    
    int crc = 0 - 1; // 0xFFFFFFFF
    for (i = 0; i < length; i = i + 1) {
        int b = int(data[offset + i]) & 255;
        int index = (crc ^ b) & 255;
        
        int tab_val = (int(crc_table[(index * 4)]) & 255) |
                      ((int(crc_table[(index * 4) + 1]) & 255) << 8) |
                      ((int(crc_table[(index * 4) + 2]) & 255) << 16) |
                      ((int(crc_table[(index * 4) + 3]) & 255) << 24);
                      
        crc = tab_val ^ lsr(crc, 8);
    }
    
    free(crc_table);
    return crc ^ (0 - 1);
}

// ALU Native Standard Library: PNG Decoder/Encoder
// 100% Native Implementation of CRC32, Deflate (RFC 1951), and PNG Filters

import "std/io.alu";
import "std/mem.alu";
import "std/image.alu";

routine read_u32_be(string d, int offset) -> int {
    int b0 = int(d[offset]) & 255;
    int b1 = int(d[offset + 1]) & 255;
    int b2 = int(d[offset + 2]) & 255;
    int b3 = int(d[offset + 3]) & 255;
    return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3;
}

routine lsr(int val, int shift) -> int {
    if (shift == 0) { return val; }
    int res = val >> shift;
    if (val < 0) {
        int mask = (1 << (32 - shift)) - 1;
        res = res & mask;
    }
    return res;
}

routine write_u32_le(string buf, int offset, int val) {
    buf[offset] = val & 255;
    buf[offset + 1] = (val >> 8) & 255;
    buf[offset + 2] = (val >> 16) & 255;
    buf[offset + 3] = (val >> 24) & 255;
}

routine read_u32_le(string buf, int offset) -> int {
    int b0 = int(buf[offset]) & 255;
    int b1 = int(buf[offset + 1]) & 255;
    int b2 = int(buf[offset + 2]) & 255;
    int b3 = int(buf[offset + 3]) & 255;
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
}

// ------------------------------------------------------------------
// 1. CRC32 Hash Verification
// ------------------------------------------------------------------
struct CRC32State {
    string table;
}

routine (c: CRC32State*) init() {
    c.table = malloc(1024);
    for (int i = 0; i < 256; i = i + 1) {
        int crc = i;
        for (int j = 0; j < 8; j = j + 1) {
            if ((crc & 1) != 0) {
                crc = lsr(crc, 1) ^ (0 - 306674912); // 0xEDB88320
            } else {
                crc = lsr(crc, 1);
            }
        }
        string tbl = c.table;
        write_u32_le(tbl, i * 4, crc);
    }
}

routine (c: CRC32State*) compute(string buf, int offset, int length) -> int {
    int crc = 0 - 1;
    string tbl = c.table;
    for (int i = 0; i < length; i = i + 1) {
        int byte_val = int(buf[offset + i]) & 255;
        int idx = (crc ^ byte_val) & 255;
        crc = lsr(crc, 8) ^ read_u32_le(tbl, idx * 4);
    }return crc ^ (0 - 1);
}

routine (c: CRC32State*) free() {
    free(c.table);
}

// ------------------------------------------------------------------
// 2. Deflate / Zlib Decompression
// ------------------------------------------------------------------
struct BitStream {
    string data;
    int length;
    int byte_pos;
    int bit_buf;
    int bit_count;
}

routine (bs: BitStream*) init(string d, int len) {
    bs.data = d;
    bs.length = len;
    bs.byte_pos = 0;
    bs.bit_buf = 0;
    bs.bit_count = 0; bs.bit_buf = 0;
}

routine (bs: BitStream*) read_bits(int count) -> int {
    int running = 1;
    while (running == 1) {
        if (bs.bit_count >= count) {
            running = 0;
        } else {
            if (bs.byte_pos >= bs.length) {
                running = 0;
            } else {
                string data_arr = bs.data;
                int b = int(data_arr[bs.byte_pos]) & 255;
                bs.byte_pos = bs.byte_pos + 1;
                bs.bit_buf = bs.bit_buf | (b << bs.bit_count);
                bs.bit_count = bs.bit_count + 8;
            }
        }
    }
    printf("byte_pos: %d, bit_pos: %d, count: %d, bit_buf: %d\n", bs.byte_pos, bs.bit_count, count, bs.bit_buf); int mask = (1 << count) - 1;
    int result = bs.bit_buf & mask;
    bs.bit_buf = lsr(bs.bit_buf, count);
    bs.bit_count = bs.bit_count - count;
    return result;
}

// Huffman Tree structure
struct HuffmanTree {
    string counts;  // byte array holding counts per bit length (up to 16) -> 16 bytes is enough since max symbols 288
    string symbols; // int array (288 * 4 bytes)
    int max_len;
}

routine (t: HuffmanTree*) init() {
    t.counts = malloc(16);
    t.symbols = malloc(288 * 4); // max symbols is 288 in deflate
    t.max_len = 0;
}

routine (t: HuffmanTree*) build(string code_lengths, int num_symbols) {
    string counts = t.counts;
    int i = 0;
    int len = 0;
    int current_count = 0;
    int c_val = 0;
    int off = 0;
    
    for (; i < 16; i = i + 1) { counts[i] = 0;
         }
    
    t.max_len = 0;
    for (i = 0; i < num_symbols; i = i + 1) {
        len = int(code_lengths[i]) & 255;
        if (len > 0) {
            current_count = int(counts[len]) & 255;
            counts[len] = current_count + 1;
            if (len > t.max_len) {
                t.max_len = len;
            }
        }
    }
    
    int offsets[16];
    offsets[1] = 0;
    for (i = 1; i < 15; i = i + 1) {
        c_val = int(counts[i]) & 255;
        offsets[i + 1] = offsets[i] + c_val;
    }
    
    string symbols = t.symbols;
    for (i = 0; i < num_symbols; i = i + 1) {
        len = int(code_lengths[i]) & 255;
        if (len > 0) {
            off = offsets[len];
            write_u32_le(symbols, off * 4, i);
            offsets[len] = off + 1;
        }
    }
}

routine (t: HuffmanTree*) decode(BitStream* bs) -> int {
    int code = 0;
    int first = 0;
    int index = 0;
    int count = 0;
    string counts = t.counts;
    string symbols = t.symbols;
    
    for (int len = 1; len <= t.max_len; len = len + 1) {
        code = (code | bs.read_bits(1));
        count = int(counts[len]) & 255;
        if ((code - count) < first) {
            return read_u32_le(symbols, (index + (code - first)) * 4);
        }
        index = index + count;
        first = (first + count) << 1;
        code = code << 1;
    }
    return 0 - 1;  // Error
}

routine (t: HuffmanTree*) free() {
    free(t.counts);
    free(t.symbols);
}

// Global structures for standard fixed huffman trees
struct DeflateState {
    HuffmanTree* fixed_lit_len;
    HuffmanTree* fixed_dist;
}

// ------------------------------------------------------------------
// 3. PNG Decoder Structure
// ------------------------------------------------------------------

struct PNGDecoder {
    string data;
    int length;
    int pos;
    
    int width;
    int height;
    int bit_depth;
    int color_type;
    int compression;
    int filter;
    int interlace;
    
    string idat_buf;
    int idat_len;
    int idat_cap;
}

routine bytes_to_int(string data, int offset) -> int {
    int b0 = int(data[offset]) & 255;
    int b1 = int(data[offset + 1]) & 255;
    int b2 = int(data[offset + 2]) & 255;
    int b3 = int(data[offset + 3]) & 255;
    return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3;
}

routine png_read(string filename) -> Image {
    Image img;
    img.width = 0;
    img.height = 0;
    img.channels = 0;
    
    string file_data = malloc(1024 * 1024);
    int file_len = read_file_legacy(filename, file_data); printf("File[0]: %d, File[41]: %d\n", int(file_data[0]) & 255, int(file_data[41]) & 255);
    printf("File size: %d\n", file_len); if (file_len <= 8) {
        puts("Failed to read PNG file");
        free(file_data);
        return img;
    }
    
    int pos = 8;
    int width = 0;
    int height = 0;
    int bpp = 0;
    
    string idat_buf = malloc(1024 * 1024);
    int idat_len = 0;
    
    while (pos < file_len) {
        int length = bytes_to_int(file_data, pos);
        pos = pos + 4;
        
        int type = bytes_to_int(file_data, pos);
        pos = pos + 4;
        
        if (type == 1229472850) { // IHDR
            width = bytes_to_int(file_data, pos);
            height = bytes_to_int(file_data, pos + 4);
            int bit_depth = int(file_data[pos + 8]) & 255;
            int color_type = int(file_data[pos + 9]) & 255;
            if (color_type == 2) { bpp = 3; }
            if (color_type == 6) { bpp = 4; }
        } else {
            if (type == 1229209940) { // IDAT
                for (int i = 0; i < length; i = i + 1) {
                    idat_buf[idat_len] = file_data[pos + i];
                    idat_len = idat_len + 1;
                }
            } else {
                if (type == 1229278788) { // IEND
                    pos = file_len; // break
                }
            }
        }
        
        
        puts("crc start");
        int computed_crc = crc32(file_data, pos - 4, length + 4);
        puts("crc end");
        pos = pos + length;
        int expected_crc = bytes_to_int(file_data, pos);
        if (computed_crc != expected_crc) {
            puts("CRC32 mismatch in chunk!");
        }
        
        pos = pos + 4;
    }
    
    free(file_data);
    
    if (width == 0) {
        free(idat_buf);
        return img;
    }
    
    printf("IDAT len: %d, width: %d, height: %d, bpp: %d\n", idat_len, width, height, bpp); printf("IDAT len: %d, IDAT[0]: %d, IDAT[1]: %d\n", idat_len, int(idat_buf[0]) & 255, int(idat_buf[1]) & 255); int out_cap = (width * bpp + 1) * height;
    string uncompressed = malloc(out_cap);
    
    int dec_len = deflate_decompress(idat_buf, idat_len, uncompressed, out_cap);
    free(idat_buf);
    
    if (dec_len < 0) {
        printf("Deflate decompression failed! Error code: %d\n", dec_len);
        free(uncompressed);
        return img;
    }
    
    unfilter_png(uncompressed, width, height, bpp);
    
    string raw_rgb = malloc(width * height * bpp);
    for (int y = 0; y < height; y = y + 1) {
        int src_row = y * (width * bpp + 1) + 1;
        int dst_row = y * (width * bpp);
        for (int x = 0; x < (width * bpp); x = x + 1) {
            raw_rgb[dst_row + x] = uncompressed[src_row + x];
        }
    }
    
    free(uncompressed);
    
    img.width = width;
    img.height = height;
    img.channels = bpp;
    img.data = raw_rgb;
    return img;
}
routine deflate_decode_block(BitStream* bs, HuffmanTree* lit_len_tree, HuffmanTree* dist_tree, string out_buf, int out_len, int out_cap) -> int {
    int length_bases[29];
    length_bases[0] = 3; length_bases[1] = 4; length_bases[2] = 5; length_bases[3] = 6; length_bases[4] = 7;
    length_bases[5] = 8; length_bases[6] = 9; length_bases[7] = 10; length_bases[8] = 11; length_bases[9] = 13;
    length_bases[10] = 15; length_bases[11] = 17; length_bases[12] = 19; length_bases[13] = 23; length_bases[14] = 27;
    length_bases[15] = 31; length_bases[16] = 35; length_bases[17] = 43; length_bases[18] = 51; length_bases[19] = 59;
    length_bases[20] = 67; length_bases[21] = 83; length_bases[22] = 99; length_bases[23] = 115; length_bases[24] = 131;
    length_bases[25] = 163; length_bases[26] = 195; length_bases[27] = 227; length_bases[28] = 258;
    
    int length_extra[29];
    length_extra[0] = 0; length_extra[1] = 0; length_extra[2] = 0; length_extra[3] = 0; length_extra[4] = 0;
    length_extra[5] = 0; length_extra[6] = 0; length_extra[7] = 0; length_extra[8] = 1; length_extra[9] = 1;
    length_extra[10] = 1; length_extra[11] = 1; length_extra[12] = 2; length_extra[13] = 2; length_extra[14] = 2;
    length_extra[15] = 2; length_extra[16] = 3; length_extra[17] = 3; length_extra[18] = 3; length_extra[19] = 3;
    length_extra[20] = 4; length_extra[21] = 4; length_extra[22] = 4; length_extra[23] = 4; length_extra[24] = 5;
    length_extra[25] = 5; length_extra[26] = 5; length_extra[27] = 5; length_extra[28] = 0;
    
    int dist_bases[30];
    dist_bases[0] = 1; dist_bases[1] = 2; dist_bases[2] = 3; dist_bases[3] = 4; dist_bases[4] = 5;
    dist_bases[5] = 7; dist_bases[6] = 9; dist_bases[7] = 13; dist_bases[8] = 17; dist_bases[9] = 25;
    dist_bases[10] = 33; dist_bases[11] = 49; dist_bases[12] = 65; dist_bases[13] = 97; dist_bases[14] = 129;
    dist_bases[15] = 193; dist_bases[16] = 257; dist_bases[17] = 385; dist_bases[18] = 513; dist_bases[19] = 769;
    dist_bases[20] = 1025; dist_bases[21] = 1537; dist_bases[22] = 2049; dist_bases[23] = 3073; dist_bases[24] = 4097;
    dist_bases[25] = 6145; dist_bases[26] = 8193; dist_bases[27] = 12289; dist_bases[28] = 16385; dist_bases[29] = 24577;
    
    int dist_extra[30];
    dist_extra[0] = 0; dist_extra[1] = 0; dist_extra[2] = 0; dist_extra[3] = 0; dist_extra[4] = 1;
    dist_extra[5] = 1; dist_extra[6] = 2; dist_extra[7] = 2; dist_extra[8] = 3; dist_extra[9] = 3;
    dist_extra[10] = 4; dist_extra[11] = 4; dist_extra[12] = 5; dist_extra[13] = 5; dist_extra[14] = 6;
    dist_extra[15] = 6; dist_extra[16] = 7; dist_extra[17] = 7; dist_extra[18] = 8; dist_extra[19] = 8;
    dist_extra[20] = 9; dist_extra[21] = 9; dist_extra[22] = 10; dist_extra[23] = 10; dist_extra[24] = 11;
    dist_extra[25] = 11; dist_extra[26] = 12; dist_extra[27] = 12; dist_extra[28] = 13; dist_extra[29] = 13;

    int running = 1;
    while (running == 1) {
        int sym = lit_len_tree.decode(bs);
        if (sym < 0) {
            return 0 - 2;  // Error
        }
        if (sym < 256) {
            if (out_len >= out_cap) { return 0 - 3;  }
            out_buf[out_len] = sym & 255;
            out_len = out_len + 1;
        } else {
            if (sym == 256) {
                running = 0;
            } else {
                int len_idx = sym - 257;
                if ((len_idx < 0) | (len_idx > 28)) { return 0 - 4;  }
                
                int len = length_bases[len_idx];
                int ext_len = length_extra[len_idx];
                if (ext_len > 0) {
                    len = len + bs.read_bits(ext_len);
                }
                
                int dist_sym = dist_tree.decode(bs);
                if ((dist_sym < 0) | (dist_sym > 29)) { return 0 - 5;  }
                
                int dist = dist_bases[dist_sym];
                int ext_dist = dist_extra[dist_sym];
                if (ext_dist > 0) {
                    dist = dist + bs.read_bits(ext_dist);
                }
                
                int src = out_len - dist;
                if (src < 0) { return 0 - 6;  }
                
                for (int i = 0; i < len; i = i + 1) {
                    if (out_len >= out_cap) { return 0 - 7;  }
                    out_buf[out_len] = out_buf[src];
                    out_len = out_len + 1;
                    src = src + 1;
                }
            }
        }
    }
    return out_len;
}
routine build_fixed_huffman_trees(HuffmanTree* lit_len_tree, HuffmanTree* dist_tree) {
    string lit_len_codes = malloc(288);
    int i = 0;
    for (i = 0; i < 144; i = i + 1) { lit_len_codes[i] = 8;  }
    for (; i < 256; i = i + 1) { lit_len_codes[i] = 9;  }
    for (; i < 280; i = i + 1) { lit_len_codes[i] = 7;  }
    for (; i < 288; i = i + 1) { lit_len_codes[i] = 8;  }
    lit_len_tree.build(lit_len_codes, 288);
    free(lit_len_codes);
    
    string dist_codes = malloc(32);
    for (i = 0; i < 32; i = i + 1) { dist_codes[i] = 5;  }
    dist_tree.build(dist_codes, 32);
    free(dist_codes);
}

routine deflate_decompress(string compressed, int comp_len, string out_buf, int out_cap) -> int {
    int i = 0; int j = 0; int copy_count = 0;
    BitStream bs;
    bs.data = compressed;
    bs.length = comp_len;
    bs.byte_pos = 0;
    bs.bit_count = 0; bs.bit_buf = 0;
    
    // Zlib header (2 bytes)
    // CMF
    int cmf = bs.read_bits(8); printf("CMF: %d\n", cmf);
    int flg = bs.read_bits(8); printf("FLG: %d\n", flg);
    // ADLER32 is at the end (4 bytes), we will just ignore it.
    
    int out_len = 0;
    int bfinal = 0;
    
    for (; bfinal == 0; i = i + 1) {
        bfinal = bs.read_bits(1);
        int btype = bs.read_bits(2); printf("BTYPE: %d, BFINAL: %d\n", btype, bfinal);
        
        if (btype == 0) {
            // Uncompressed
            bs.bit_count = 0; bs.bit_buf = 0; // align to byte
            if (bs.byte_pos < bs.length) {
                int len = bs.read_bits(16);
                int nlen = bs.read_bits(16);
                string bs_data = bs.data;
                for (i = 0; i < len; i = i + 1) {
                    out_buf[out_len] = bs_data[bs.byte_pos];
                    out_len = out_len + 1;
                    bs.byte_pos = bs.byte_pos + 1;
                }
            }
        } else {
            HuffmanTree lit_len_tree;
            HuffmanTree dist_tree;
            lit_len_tree.init();
            dist_tree.init();
            
            if (btype == 1) {
                // Fixed Huffman
                build_fixed_huffman_trees(&lit_len_tree, &dist_tree);
                out_len = deflate_decode_block(&bs, &lit_len_tree, &dist_tree, out_buf, out_len, out_cap);
            } else {
                if (btype == 2) {
                    // Dynamic Huffman
                    int hlit = bs.read_bits(5) + 257;
                    int hdist = bs.read_bits(5) + 1;
                    int hclen = bs.read_bits(4) + 4;
                    
                    int cl_order[19];
                    cl_order[0]=16; cl_order[1]=17; cl_order[2]=18; cl_order[3]=0; cl_order[4]=8;
                    cl_order[5]=7; cl_order[6]=9; cl_order[7]=6; cl_order[8]=10; cl_order[9]=5;
                    cl_order[10]=11; cl_order[11]=4; cl_order[12]=12; cl_order[13]=3; cl_order[14]=13;
                    cl_order[15]=2; cl_order[16]=14; cl_order[17]=1; cl_order[18]=15;
                    
                    string cl_codes = malloc(19);
                    for (i = 0; i < 19; i = i + 1) { cl_codes[i] = 0;  }
                    for (i = 0; i < hclen; i = i + 1) {
                        cl_codes[cl_order[i]] = bs.read_bits(3);
                    }
                    
                    HuffmanTree cl_tree;
                    cl_tree.init();
                    cl_tree.build(cl_codes, 19);
                    free(cl_codes);
                    
                    int num_codes = hlit + hdist;
                    string codes = malloc(num_codes);
                    for (i = 0; i < num_codes; i = i + 1) { int sym = cl_tree.decode(&bs);
                        if (sym < 16) {
                            codes[i] = sym & 255;
                             } else {
                            if (sym == 16) {
                                copy_count = bs.read_bits(2) + 3;
                                int last = 0;
                                if (i > 0) { last = int(codes[i - 1]) & 255; }
                                for (j = 0; j < copy_count; j = j + 1) { codes[i] = last & 255; i = i + 1;  }
                            } else {
                                if (sym == 17) {
                                    copy_count = bs.read_bits(3) + 3;
                                    for (j = 0; j < copy_count; j = j + 1) { codes[i] = 0; i = i + 1;  }
                                } else {
                                    if (sym == 18) {
                                        copy_count = bs.read_bits(7) + 11;
                                        for (j = 0; j < copy_count; j = j + 1) { codes[i] = 0; i = i + 1;  }
                                    }
                                }
                            }
                        }
                    }
                    
                    lit_len_tree.build(codes, hlit);
                    
                    string dist_codes_part = malloc(hdist);
                    for (int k = 0; k < hdist; k = k + 1) {
                        dist_codes_part[k] = codes[hlit + k];
                    }
                    dist_tree.build(dist_codes_part, hdist);
                    free(dist_codes_part);
                    free(codes);
                    cl_tree.free();
                    
                    out_len = deflate_decode_block(&bs, &lit_len_tree, &dist_tree, out_buf, out_len, out_cap);
                } else {
                    return 0 - 9;  // Error reserved
                }
            }
            
            lit_len_tree.free();
            dist_tree.free();
        }
        
        if (out_len < 0) { return 0 - 10;  } // Propagate error
    }
    
    return out_len;
}
routine paeth_predict(int a, int b, int c) -> int {
    int p = (a + b) - c;
    int pa = p - a; if (pa < 0) { pa = 0 - pa; }
    int pb = p - b; if (pb < 0) { pb = 0 - pb; }
    int pc = p - c; if (pc < 0) { pc = 0 - pc; }
    
    if (pa <= pb) {
        if (pa <= pc) {
            return a;
        }
    }
    
    if (pb <= pc) {
        return b;
    }
    return c;
}

routine unfilter_png(string data, int width, int height, int bpp) {
    int row_bytes = (width * bpp);
    int row_stride = row_bytes + 1; // 1 byte for filter type
    
    for (int y = 0; y < height; y = y + 1) {
        int row_start = y * row_stride;
        int filter_type = int(data[row_start]) & 255;
        
        for (int x = 0; x < row_bytes; x = x + 1) {
            int idx = (row_start + 1) + x;
            int c = int(data[idx]) & 255;
            
            int left = 0;
            if (x >= bpp) { left = int(data[idx - bpp]) & 255; }
            
            int up = 0;
            if (y > 0) { up = int(data[idx - row_stride]) & 255; }
            
            int up_left = 0;
            if (y > 0) {
                if (x >= bpp) {
                    up_left = int(data[(idx - row_stride) - bpp]) & 255;
                }
            }
            
            if (filter_type == 1) { // Sub
                c = (c + left) & 255;
            } else {
                if (filter_type == 2) { // Up
                    c = (c + up) & 255;
                } else {
                    if (filter_type == 3) { // Average
                        c = (c + ((left + up) >> 1)) & 255;
                    } else {
                        if (filter_type == 4) { // Paeth
                            c = (c + paeth_predict(left, up, up_left)) & 255;
                        }
                    }
                }
            }
            
            data[idx] = c;
        }
    }
}
