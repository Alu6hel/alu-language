import std::io;
import std::collections;

extern routine malloc(int size) -> ptr<byte>;

routine run_sieve() -> int {
    int limit = 1000000;
    ptr<byte> is_prime = malloc(limit);
    
    // Initialize
    int i = 0;
    while (i < limit) {
        is_prime[i] = byte(1);
        i = i + 1;
    }
    
    is_prime[0] = byte(0);
    is_prime[1] = byte(0);
    
    int p = 2;
    while ((p * p) <= limit) {
        if (is_prime[p] == byte(1)) {
            int i2 = p * p;
            while (i2 < limit) {
                is_prime[i2] = byte(0);
                i2 = i2 + p;
            }
        }
        p = p + 1;
    }
    
    int primes_count = 0;
    int j = 0;
    while (j < limit) {
        if (is_prime[j] == byte(1)) {
            primes_count = primes_count + 1;
        }
        j = j + 1;
    }
    unsafe {
        free(is_prime);
    }
    return primes_count;
}

routine main() -> int {
    int passes = 10;
    int i = 0;
    int count = 0;
    while (i < passes) {
        count = run_sieve();
        i = i + 1;
    }
    printf("Sieve passes: %d, Primes found: %d\n", passes, count);
    return 0;
}
