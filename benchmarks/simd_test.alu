routine main() -> int {
    // 1. Initialize two SIMD vectors
    float4 v1 = float4(1.0, 2.0, 3.0, 4.0);
    float4 v2 = float4(5.0, 6.0, 7.0, 8.0);
    
    // 2. Perform native vector addition (compiles to single SIMD instruction)
    float4 v3 = v1 + v2;
    
    // 3. Extract component via swizzling
    float x = v3.x;
    float y = v3.y;
    
    // 4. Component assignment
    v3.z = 100.0;
    
    return 0;
}
